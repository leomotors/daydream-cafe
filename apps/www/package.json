    "@daydream-cafe/data": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "clsx": "^2.1.1",
    "katex": "^0.16.47",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
