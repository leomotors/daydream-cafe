{
  "name": "resume.leomotors.me",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port=5911 --clearScreen=false",
    "build": "vite build",
    "preview": "vite preview --port=4911",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check \"src/**/*.{css,scss}\" && eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.{css,scss}\" && eslint . --fix"
  },
  "devDependencies": {
    "@daydream-cafe/config": "workspace:*",
    "@daydream-cafe/data": "workspace:*",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "autoprefixer": "^10.6.1",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.105.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-preprocess": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@daydream-cafe/constants": "workspace:*"
  }
}
