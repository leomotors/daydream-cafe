{
  "name": "@repo/ui",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src",
    "format": "eslint src --fix"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./atoms/*": {
      "types": "./src/atoms/*/index.ts",
      "svelte": "./src/atoms/*/index.ts",
      "default": "./src/atoms/*/index.ts"
    },
    "./icons/*": {
      "types": "./src/icons/*",
      "svelte": "./src/icons/*",
      "default": "./src/icons/*"
    },
    "./globals.css": "./src/globals.css",
    "./utils": {
      "types": "./src/utils.ts",
      "default": "./src/utils.ts",
      "svelte": "./src/utils.ts"
    }
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.49.0",
    "bits-ui": "^2.19.4",
    "clsx": "^2.1.1",
    "svelte": "^5.57.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@daydream-cafe/config": "workspace:*",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.1",
    "eslint": "^10.11.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3"
  }
}
