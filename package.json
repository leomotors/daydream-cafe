{
  "name": "@leomotors/daydream-cafe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build --continue=dependencies-successful",
    "dev": "turbo run dev",
    "preview": "turbo run preview",
    "lint": "turbo run lint --continue",
    "format": "turbo run format --continue",
    "check": "turbo run check --continue"
  },
  "devDependencies": {
    "@daydream-cafe/config": "workspace:*",
    "@types/node": "^24.19.1",
    "@typescript-eslint/parser": "^8.71.0",
    "bun-types": "^1.4.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tailwindcss": "4.3.3",
    "turbo": "^2.11.6",
    "wrangler": "^4.145.0"
  },
  "engines": {
    "node": "^24.11"
  },
  "packageManager": "pnpm@12.8.2"
}
